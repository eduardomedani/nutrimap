
# Scripts SQL com dados de paciente (não versionar — o repositório é público).
# São migrações pontuais que carregam nome completo e UUID reais.
db/ficha_eduardo_*.sql
db/treino_eduardo_*.sql

# Seeds com dados pessoais de colaboradores (nao versionar — repositorio publico).
# Nome completo, CPF, RG, endereco, chave Pix e salario de gente real.
# O SCHEMA vai versionado; os DADOS ficam so na maquina e no Supabase.
db/funcionarios_seed.sql
db/folha_historico_seed.sql

# Caixa da empresa: 310 despesas com fornecedor, valor e data reais, de 2023 a
# 2026. O GERADOR (db/gerador_custos.mjs) e o SCHEMA vao versionados — quem
# tiver a planilha reproduz o arquivo com um comando. Os numeros, nao.
db/financeiro_lancamentos_seed.sql

# Vendas: 2.177 receitas com NOME DE 313 CLIENTES, valor e data. Mesma regra —
# db/gerador_vendas.mjs vai versionado, os dados nao. Aqui e mais grave que nos
# custos: sao pessoas fisicas, nao fornecedores.
db/financeiro_vendas_seed.sql

# Controle de clientes da GoUp: 144 pessoas com NOME COMPLETO, TELEFONE, preco
# contratado e observacoes comerciais ("pediu desconto", "vai viajar"). Mesma
# regra dos outros seeds — db/gerador_clientes.mjs vai versionado, os dados
# nao. Quem tiver a planilha reproduz os arquivos com um comando.
db/comercial_clientes_seed.sql
db/comercial_clientes_dados.json
db/comercial_clientes_seed_limpo.sql

# Correcao de folha ja gravada: traz nome de colaborador e valor de bonus.
# Mesma regra dos seeds — a decisao esta documentada no proprio arquivo, que
# fica na maquina e no Supabase.
db/folha_correcao_bonus.sql
db/folha_correcao_bonus_desfazer.sql

# Correcoes pontuais de vinculo, escritas com o UUID real da conta e do
# funcionario. Sao artefatos de uma sessao de conferencia: ja cumpriram a
# funcao e nao servem para outra maquina. As consultas de conferencia que
# NAO trazem UUID real (db/conferencia/0*.sql em diante) vao versionadas.
db/conferencia/46_desfazer_vinculo_indevido.sql
db/conferencia/47_desfazer_vinculo_indevido_rollback.sql

# Conferencia da importacao comercial: traz o UUID real da conta do nutri.
# Mesma regra dos outros arquivos de conferencia com UUID — fica na maquina.
db/conferencia/48_comercial_importacao.sql

# Versao sem comentarios, gerada para colar no SQL Editor. O "--" se perde no
# paste e o resto da linha vira comando, entao a copia limpa e artefato de
# trabalho: sempre gerada a partir do arquivo com comentario, que esse sim vai
# versionado. As duas linhas convivem — a primeira ja cobria db/, e a segunda
# passou a ser necessaria quando os scripts de conferencia ganharam subpasta.
db/*_LIMPO.sql
db/**/*_LIMPO.sql

# Vendas que a importacao assumiu como recebidas: traz nome de cliente e valor.
# O gerador vai versionado; a lista, nao.
db/vendas_duvidosas.csv

# Conciliacao das vendas duvidosas: nome de cliente + memo do extrato.
db/vendas_conciliadas.csv

# Atualizacao dos pagamentos: traz nome, valor e data de cliente real, e o
# periodo contratado de cada um. Mesma regra dos seeds —
# db/gerador_atualizacao_pagamentos.mjs vai versionado, os dados nao. Quem
# tiver a planilha reproduz os quatro arquivos com um comando.
#
# O JSON e a UNICA parte que o gerador nao sabe deduzir: quem pagou sem ter
# assinatura aparece sozinho, mas com que plano e por quanto a pessoa fechou e
# leitura humana do historico. Por isso ele e dado de entrada, e nao saida.
db/comercial_atualizar_pagamentos.sql
db/comercial_atualizar_pagamentos_desfazer.sql
db/comercial_clientes_novos.json

# Preferencias do Claude Code desta MAQUINA (permissoes locais). O
# .claude/settings.json vai versionado; este nao.
.claude/settings.local.json

# Pagamentos da planilha "Pagamentos.xlsx": o retrato do banco traz NOME DE
# CLIENTE, valor, data e periodo contratado, e os dois scripts gerados a partir
# dele carregam a mesma coisa. Mesma regra dos outros seeds —
# db/gerador_pagamentos_da_planilha.mjs vai versionado, os dados nao. Quem tiver
# a planilha e rodar db/conferencia/107_pagamentos_da_planilha_estado.sql
# reproduz os quatro arquivos com um comando.
db/retrato_pagamentos.csv
db/comercial_pagamentos_da_planilha.sql
db/comercial_pagamentos_da_planilha_desfazer.sql

# Molde de restauracao das observacoes apagadas em 31/08/2026: traz nome de
# cliente na coluna de conferencia, e e preenchido a mao com a coluna K da
# planilha "Vendas". O conserto que NAO tem nome
# (db/comercial_pagamentos_observacao_corrigir.sql) vai versionado.
db/comercial_pagamentos_observacao_restaurar.sql

# Bootstrap da organizacao de um profissional convidado: o e-mail dele e
# PREDICADO no script (`where lower(u.email) = v_email`), pareado com o uuid
# como checagem de seguranca deliberada — sanear quebraria a trava. Mesma regra
# de db/ficha_eduardo_*.sql: o dado de pessoa real fica na maquina e no
# Supabase, nao num repositorio publico.
db/organizacao_caio_bootstrap.sql
db/organizacao_caio_bootstrap_desfazer.sql
